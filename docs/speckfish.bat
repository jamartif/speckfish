@echo off
REM speckfish launcher for machines where Device Guard / App Control blocks
REM the console-script .exe generated by pip/uv (unsigned stub).
REM Drop this file in any folder on your PATH and run:  speckfish doctor
setlocal
set "PY=%APPDATA%\uv\tools\speckfish\Scripts\python.exe"
if exist "%PY%" goto run
REM fallback: whatever python is on PATH, if the package is importable there
set "PY=python"
:run
"%PY%" -m speckfish %*
exit /b %ERRORLEVEL%
